{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!node_modules",
      "!!dist",
      "!!coverage",
      "!package-lock.json",
      "!docs/reviews"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "types": "recommended",
      "project": "recommended",
      "test": "recommended"
    },
    "rules": {
      "suspicious": {
        "noExplicitAny": "error"
      },
      "preset": "recommended",
      "complexity": {
        "useLiteralKeys": "off"
      }
    }
  }
}
