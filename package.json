{
  "name": "inlang-plugin-arb",
  "version": "0.1.0",
  "description": "Lossless Flutter ARB import and export for inlang",
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --error-on-warnings .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:flutter": "node scripts/test-flutter.mjs",
    "check": "npm run typecheck && biome check --error-on-warnings . && npm run test:coverage && npm run build && npm run test:package",
    "prepack": "npm run build",
    "test:package": "node scripts/test-package.mjs",
    "deps:upgrade": "node scripts/upgrade-dependencies.mjs"
  },
  "keywords": [
    "inlang",
    "plugin",
    "flutter",
    "arb",
    "localization",
    "icu"
  ],
  "type": "module",
  "dependencies": {
    "@inlang/plugin-icu1": "^1.3.5",
    "@inlang/sdk": "^4.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "intl-messageformat": "^12.1.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "docs",
    "examples"
  ],
  "overrides": {
    "@sinclair/typebox": "0.34.52"
  }
}
